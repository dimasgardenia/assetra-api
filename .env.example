PORT=3001
# development | production — di production JWT_SECRET wajib diisi (server menolak start)
NODE_ENV=development
# true bila di belakang reverse proxy (Render/Nginx) agar rate limit membaca IP klien asli
TRUST_PROXY=false
# WAJIB diganti: string acak minimal 16 karakter (mis. `openssl rand -hex 32`)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d
DB_PATH=./data/assetra.db
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Claude API untuk AI Property Consultant (console.anthropic.com)
ANTHROPIC_API_KEY=
# Email transaksional Resend (resend.com) — WAJIB agar verifikasi email & reset sandi bisa dikirim
RESEND_API_KEY=
RESEND_FROM=Assetra <no-reply@domain-anda.com>
APP_URL=http://localhost:5173
# Google SSO (OAuth client ID dari console.cloud.google.com) — samakan dengan VITE_GOOGLE_CLIENT_ID frontend; kosong = Google Sign-In nonaktif
GOOGLE_CLIENT_ID=
